<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>klavyra-apphost-6f1c2e0a</UserSecretsId>
    <!-- Run with `dotnet run`; the separate Aspire CLI bundle is not required. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klavyra.Api\Klavyra.Api.csproj" />
    <PackageReference Include="Aspire.Hosting.Python" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
  </ItemGroup>

</Project>
